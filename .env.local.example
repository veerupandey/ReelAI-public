# Copy this file to .env.local and fill in your own values
# Gemini (required — image gen + fallback planner)
GEMINI_API_KEY=your_google_gemini_key
VITE_API_KEY=your_google_gemini_key
# Optional image model override (default: gemini-3.1-flash-image / nano banana 2)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# VITE_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Google Neural TTS via agent shell server (npm run agent:server / dev:agent)
# VITE_GOOGLE_TTS_ENABLED=true
# VITE_GOOGLE_TTS_URL=http://127.0.0.1:3721/tts
# Set on the shell server process (not VITE_):
# GOOGLE_TTS_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Multi-provider text (OpenAI-compatible + Gemini fallback) ────────────────
# Default text model is GLM 5.3 Flash via z.ai Coding Plan.
# SiliconFlow, OpenAI, and Codex also use /chat/completions (same wire format).
# You can paste keys + base URL in the UI. Images always use Gemini Flash Image.
# ZAI_API_KEY=your_z_ai_coding_plan_key
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# OPENAI_API_KEY=your_openai_key
# SILICONFLOW_API_KEY=your_siliconflow_key
# SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
